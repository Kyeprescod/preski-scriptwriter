# Copy these names into Netlify: Site configuration > Environment variables. NEVER commit real values.
# (For testing on your own computer you can copy this file to ".env" and fill it in.)

# --- Email (Resend): REQUIRED so guides, applications and plans are sent ---
RESEND_API_KEY=
MAIL_FROM="Kye at Preski Fitness <kye@preskifitness.com>"   # must be an address on a domain you verified in Resend
OWNER_EMAIL=                                                # where coaching applications and sale alerts are sent
SUPPORT_EMAIL=                                              # optional; shown to customers if the plan is delayed
RESEND_AUDIENCE_ID=                                         # optional; keeps a subscriber list you can email later

# --- Payments (Stripe): REQUIRED for the 8-week programme ---
STRIPE_SECRET_KEY=                 # sk_live_... (use sk_test_... while testing)
STRIPE_WEBHOOK_SECRET=             # whsec_... from the webhook you create in Stripe
PLAN_PRICE_PENCE=3900              # price charged in pence. 3900 = £39. Keep in step with assets/js/config.js
PLAN_DOWNLOAD_URL=                 # link to the programme file customers receive after paying

# --- Chat assistant: OPTIONAL (without it the chat uses built-in answers) ---
ANTHROPIC_API_KEY=
COACHING_PRICE="£149 per month, 3-month minimum"
CHAT_MODEL=claude-sonnet-5-5

# --- Site address (Netlify sets this automatically; only set it if your domain differs) ---
SITE_URL=https://preskifitness.com
